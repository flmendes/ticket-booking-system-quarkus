####
# Optimized Multi-stage Dockerfile for Quarkus JVM mode
#
# This uses a lightweight Alpine-based image for minimal size
# Image size reduction: ~471MB -> ~200MB
#
# Build: docker build -f src/main/docker/Dockerfile.jvm -t quarkus/ticket-booking-system-jvm .
# Run: docker run -i --rm -p 8080:8080 quarkus/ticket-booking-system-jvm
# Debug: docker run -i --rm -p 8080:8080 -p 5005:5005 -e JAVA_ENABLE_DEBUG=true quarkus/ticket-booking-system-jvm
###

# Stage 1: Build stage with Maven
FROM eclipse-temurin:21-jdk-alpine AS builder

# Install Maven
RUN apk add --no-cache maven

WORKDIR /build

# Copy dependency files first for better layer caching
COPY pom.xml ./
COPY .mvn .mvn
COPY mvnw* ./

# Download dependencies (cached if pom.xml unchanged)
RUN mvn dependency:go-offline -B || true

# Copy source code
COPY src ./src

# Build application and clean up in same layer to reduce size
RUN mvn package -DskipTests -B && \
    # Remove unnecessary files from build
    rm -rf ~/.m2/repository

# Stage 2: Lightweight runtime
FROM eclipse-temurin:21-jre-alpine

# Add required packages for Quarkus
RUN apk add --no-cache \
    curl \
    && rm -rf /var/cache/apk/*

WORKDIR /deployments

# Create non-root user
RUN addgroup -g 1001 quarkus && \
    adduser -u 1001 -G quarkus -s /bin/sh -D quarkus

# Copy application in layers for optimal caching
# Libraries change less frequently
COPY --from=builder --chown=1001:1001 /build/target/quarkus-app/lib/ ./lib/
COPY --from=builder --chown=1001:1001 /build/target/quarkus-app/*.jar ./
COPY --from=builder --chown=1001:1001 /build/target/quarkus-app/app/ ./app/
COPY --from=builder --chown=1001:1001 /build/target/quarkus-app/quarkus/ ./quarkus/

# Set environment variables
ENV LANGUAGE='en_US:en' \
    JAVA_OPTS="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager" \
    JAVA_APP_JAR="quarkus-run.jar"

EXPOSE 8080
USER 1001

# Use exec form for proper signal handling
ENTRYPOINT ["java", "-jar", "quarkus-run.jar"]
